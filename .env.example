# ELUM Make talks to the ELUM platform on Supabase: the same project as Write, Type and ELUM Account.
# Without these, Make runs in preview mode on your own computer only: everything stays in that
# browser and nothing reaches Supabase. Netlify builds refuse to run without them.
VITE_SUPABASE_URL=https://afdnnvngrpdodsfwpaqo.supabase.co
# The publishable (anon) key. Safe in the browser; row level security protects the data.
VITE_SUPABASE_ANON_KEY=

# ELUM Account: one sign-in for every ELUM app (optional until ELUM Account is deployed).
# VITE_ELUM_ACCOUNT_URL=https://elumaccounts.netlify.app
# Where the other apps live (these are the defaults).
# VITE_ELUM_WRITE_URL=https://elumwrite.netlify.app
# VITE_ELUM_TYPE_URL=https://elumtype.netlify.app
# VITE_ELUM_MAKE_URL=https://elummake.netlify.app
